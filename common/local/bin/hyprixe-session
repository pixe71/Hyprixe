#!/usr/bin/python3
"""The Hyprixe Wlogout launcher and fixed, confirmed session actions."""
import argparse
import fcntl
import json
import math
import os
from pathlib import Path
import subprocess
import sys


def margins(monitors):
    """Wlogout uses logical pixels. Let layer-shell choose the focused output."""
    if not isinstance(monitors, list) or not all(isinstance(m, dict) for m in monitors):
        raise ValueError('Invalid Hyprland monitor response')
    monitor = next((m for m in monitors if m.get('focused')), None)
    if monitor is None:
        raise ValueError('No focused Hyprland output; launch from the active desktop')
    scale = float(monitor['scale'])
    width, height = float(monitor['width']), float(monitor['height'])
    if int(monitor.get('transform', 0)) % 2:
        width, height = height, width
    if not all(math.isfinite(n) and n > 0 for n in (scale, width, height)):
        raise ValueError('Invalid output dimensions or scale')
    # A 70% wide, 26% high panel. No resolution or connector names are stored.
    return round(width / scale * .15), round(height / scale * .37)


def action(name, config):
    if name == 'lock':
        return subprocess.run([str(config / 'hypr/scripts/LockScreen.sh')], check=False).returncode
    if name == 'logout':
        active = subprocess.run(['uwsm', 'check', 'is-active', 'compositor-only'], check=False)
        if active.returncode:
            raise ValueError('Logout requires the Hyprland (uwsm-managed) session')
    # Rofi is already a Hyprixe dependency. Cancel is selected; no shell eval.
    confirmation = subprocess.run(
        ['rofi', '-config', str(config / 'hypr/rofi/config.rasi'), '-dmenu', '-i',
         '-p', name.capitalize(), '-selected-row', '0'],
        input='Cancel\nConfirm\n', capture_output=True, text=True, check=False)
    if confirmation.returncode == 1:
        return 0
    if confirmation.returncode:
        raise ValueError('Session confirmation failed: ' + confirmation.stderr.strip())
    if confirmation.stdout.strip() != 'Confirm':
        return 0
    commands = {'logout': ['uwsm', 'stop'], 'shutdown': ['systemctl', 'poweroff'],
                'reboot': ['systemctl', 'reboot']}
    return subprocess.run(commands[name], check=False).returncode


def menu(config):
    runtime = Path(os.environ['XDG_RUNTIME_DIR'])
    # Serialize launcher calls; a second press stops only our named UWSM unit.
    # A stable unit name also prevents concurrent duplicate starts after flock.
    with (runtime / 'hyprixe-wlogout.lock').open('w') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        unit = 'hyprixe-wlogout.service'
        running = subprocess.run(['systemctl', '--user', 'show', unit, '-p', 'ActiveState', '--value'],
                                 capture_output=True, text=True, check=False)
        if running.stdout.strip() in ('active', 'activating', 'reloading'):
            return subprocess.run(['systemctl', '--user', 'stop', unit], check=False).returncode
        subprocess.run(['uwsm', 'check', 'is-active', 'compositor-only'], check=True)
        result = subprocess.run(['hyprctl', '-j', 'monitors'], capture_output=True, text=True, check=True)
        horizontal, vertical = margins(json.loads(result.stdout))
        # UWSM's named transient application service is removed on exit and
        # belongs to app-graphical.slice, so logout stops this menu as well.
        return subprocess.run([
            'uwsm', 'app', '-s', 'a', '-t', 'service', '-u', unit, '--',
            'wlogout', '--protocol', 'layer-shell', '--no-span', '--buttons-per-row', '4',
            '--column-spacing', '0', '--row-spacing', '0',
            '--margin-left', str(horizontal), '--margin-right', str(horizontal),
            '--margin-top', str(vertical), '--margin-bottom', str(vertical),
            '--layout', str(config / 'wlogout/layout'), '--css', str(config / 'wlogout/style.css'),
        ], check=False).returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', nargs='?', default='menu', choices=('menu', 'lock', 'logout', 'shutdown', 'reboot'))
    args = parser.parse_args()
    config = Path(os.environ.get('XDG_CONFIG_HOME', Path.home() / '.config'))
    try:
        return menu(config) if args.action == 'menu' else action(args.action, config)
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as exc:
        print('ERROR: Hyprixe session menu: ' + str(exc), file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main())
