#!/usr/bin/env python3
"""Portable entrypoint; platform profiles only install the engine and Wallust."""
import os
from pathlib import Path
import sys
sys.dont_write_bytecode = True

data = Path(os.environ.get('XDG_DATA_HOME', Path.home() / '.local/share'))
sys.path.insert(0, str(data / 'hyprixe/theme'))
from engine import main

sys.exit(main())
