/* Shared paint from the SUPER + Space launcher. Paint the main glass once. */
@import "../wallust/colors-rofi.rasi"
window {
    background-color: @launcher-glass;
    border: 1px solid;
    border-color: @launcher-edge;
}
mainbox, custombox, mode-switcher {
    background-color: transparent;
}
listview {
    expand: true;
    fixed-height: false;
    background-color: transparent;
    border-color: @launcher-edge;
}
element normal.normal, element normal.active, element normal.urgent,
element alternate.normal, element alternate.active, element alternate.urgent {
    background-color: transparent;
    text-color: @foreground;
}
element selected.normal, element selected.active, element selected.urgent {
    background-color: @launcher-selection;
    text-color: @foreground;
}
element-icon, element-text, element-text selected {
    background-color: transparent;
    text-color: inherit;
}
inputbar {
    background-color: @launcher-input;
    border: 1px solid;
    border-color: @launcher-edge;
}
entry, prompt, textbox-prompt-colon, case-indicator {
    background-color: transparent;
    text-color: @foreground;
}
textbox {
    background-color: @launcher-input;
}
scrollbar {
    background-color: transparent;
    handle-color: @launcher-hover;
}
button selected {
    background-color: @launcher-selection;
    text-color: @foreground;
}
error-message {
    background-color: transparent;
    border-color: @launcher-edge;
}
