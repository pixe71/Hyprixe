/* Shared two-panel shell for applications and the Hyprland window switcher.
   Paint, search, rows and selection come from Frosted-Glass-Common.rasi. */
window {
    width: 70%;
    height: 58%;
}
mainbox {
    orientation: horizontal;
    spacing: 20px;
    children: [ wallpaper-panel, application-panel ];
}
wallpaper-panel {
    orientation: horizontal;
    width: 32%;
    expand: false;
    padding: 12px;
    border-radius: 8px;
    background-color: transparent;
    background-image: url("$HOME/.local/share/hyprixe/wallpapers/min_forest.jpg", height);
    hyprixe-preview-cover: true;
    children: [ launcher-sidebar, wallpaper-space ];
}
wallpaper-space { background-color: transparent; }
launcher-sidebar {
    orientation: vertical;
    expand: false;
    spacing: 12px;
    background-color: transparent;
    children: [ sidebar-top, button-applications, button-files, button-windows, button-terminal, sidebar-bottom ];
}
sidebar-top, sidebar-bottom { background-color: transparent; }
button-applications, button-files, button-windows, button-terminal {
    expand: false;
    width: 2.6em;
    /* Text buttons derive height from font metrics; padding makes them round. */
    padding: 0.75em 0;
    border-radius: 100%;
    background-color: @launcher-button;
    text-color: @foreground;
    font: "FontAwesome 18";
    horizontal-align: 0.5;
    vertical-align: 0.5;
    cursor: pointer;
}
button-applications {
    str: "";
    action: "kb-custom-1";
}
button-files {
    str: "";
    action: "kb-custom-17";
}
button-windows {
    str: "";
    action: "kb-custom-18";
}
button-terminal {
    str: "";
    action: "kb-custom-19";
}
button-applications hover, button-files hover, button-windows hover, button-terminal hover {
    background-color: @launcher-hover;
    text-color: @foreground;
}
application-panel {
    orientation: vertical;
    spacing: 10px;
    background-color: transparent;
    children: [ inputbar, message, listview ];
}
