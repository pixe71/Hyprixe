normal-background: #284D5B;
normal-foreground: #E0F0F5;
urgent-background: #91C2CF;
urgent-foreground: #E0F0F5;

alternate-active-background: #457081;
alternate-active-foreground: #E0F0F5;
alternate-normal-background: #284D5B;
alternate-normal-foreground: #E0F0F5;
alternate-urgent-background: #284D5B;
alternate-urgent-foreground: #E0F0F5;

