[Unit]
Description=Hyprixe login theme snapshot receiver
Requires=hyprixe-sddm-sync.socket
After=hyprixe-sddm-sync.socket

[Service]
ExecStart=/usr/bin/python3 -I /usr/libexec/hyprixe/sddm_sync.py serve
User=hyprixe-theme
Group=hyprixe-theme
StateDirectory=hyprixe/theme
StateDirectoryMode=0755
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
LockPersonality=yes
MemoryMax=512M
TasksMax=8
TimeoutStopSec=5
